---
import { getCollection, type CollectionEntry, render } from 'astro:content'
import { COUNT } from 'astro:env/client'
import Date from '@/components/Date.astro'

type IPost = CollectionEntry<'blog'>

const { index = 0 }: { index?: number } = Astro.props

const posts: IPost[] = (await getCollection('blog'))
  .sort((a, b) => (b.data.date?.valueOf() || 0) - (a.data.date?.valueOf() || 0))

const length = Math.ceil(posts.length / COUNT)
const result = []
for (let i = 0; i < posts.length; i += COUNT)
  result.push(posts.slice(i, i + COUNT))

const chooseResult = result[index]

for (let i = 0; i < chooseResult.length; i++)
  chooseResult[i].body = chooseResult[i].body?.slice(0, 160)

---

<section>
  <ul class="post__list">
    {chooseResult.map((post) => (
      <li class="post__item">
        <div class="post__top">
      		<Date date={post.data.date} update={post.data.updated} />
          <h2 class="post__title">{post.data.title}</h2>
        </div>
        <p class="post__text">{post.body}</p>
				<div class="post__bottom">
				  <a class="post__button" href={`/post/${post.id}`}>閱讀全文 ↲</a>
				</div>
      </li>
    ))}
  </ul>
</section>
<section>
  <ul class="page__container">
	<li class={ `page__button ${(index <= 0) && 'disabled' || ''}` }>
		<a href={ index > 1 ? `/page/${index}` : '/' }>
		  <span class="page__icon">{ index ? '⇠' : '⇤' }</span>
			<span>prev</span>
		</a>
	</li>
	{
		Array.from({ length }).map((_item, idx) => (
		<li class={ `page__button ${(index === idx) && 'active' || ''}` } >
		  <a href={ idx ? `/page/${idx + 1}` : '/' }>{ idx + 1 }</a>
		</li>
		))
	}
	<li class={ `page__button ${(index >= length - 1) && 'disabled' || ''}` }>
		<a href={ index < length - 1 ? `/page/${index + 2}` : `#` }>
			<span>next</span>
		  <span class="page__icon">{ index < length - 1 ? '⇢' : '⇥' }</span>
		</a>
	</li>
  </ul>
</section>
